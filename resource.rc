#include <windows.h>
#include "src/resource.h"

// 1: Primary Application Icon (App Icon for FeathrPDF.exe)
IDI_APP_ICON ICON "app.ico"

// 2: Document File Icon for .pdf files in Windows Explorer
IDI_DOC_ICON ICON "pdf_doc.ico"

// Common Controls & DPI Awareness Manifest
1 24 "src/app.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "h_nguynn0"
            VALUE "FileDescription", "FeathrPDF - Lightweight & Ultra-Fast PDF Reader & Editor"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "FeathrPDF"
            VALUE "LegalCopyright", "Copyright (C) 2026 h_nguynn0. All rights reserved."
            VALUE "OriginalFilename", "FeathrPDF.exe"
            VALUE "ProductName", "FeathrPDF"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
